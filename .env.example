# Copy to .env (git-ignored) and fill in the passwords:  cp .env.example .env
# One file, one set of names: the Python settings (iqs_common.settings) read these,
# and docker compose builds POSTGRES_* and NEO4J_AUTH from the same variables.
# Keep values unquoted and avoid "$" in passwords (compose interpolates "$").

IQS_ENVIRONMENT=dev
IQS_LOGGING__LEVEL=INFO
IQS_LOGGING__JSON_OUTPUT=true

# PostgreSQL 16 + pgvector. HOST/PORT are as seen from the WSL shell (bound to 127.0.0.1).
# 5433, not 5432: a PostgreSQL installed on Windows usually holds 5432, and WSL would
# then silently reach that server instead of the container.
IQS_DATABASE__HOST=localhost
IQS_DATABASE__PORT=5433
IQS_DATABASE__NAME=iqs
IQS_DATABASE__USER=iqs
IQS_DATABASE__PASSWORD=
IQS_DATABASE__POOL_SIZE=5

# Neo4j 5 community. USER must stay "neo4j"; PASSWORD needs at least 8 characters.
IQS_NEO4J__URI=bolt://localhost:7687
IQS_NEO4J__USER=neo4j
IQS_NEO4J__PASSWORD=

# HTTP APIs (vision :8001, diagnosis :8002). X-API-Key must match one of these keys.
# Comma-separated so a key can be rotated (new,old). Required by compose for the apps profile;
# with no key, every /v1 request is rejected. Example: openssl rand -hex 24
IQS_API__KEYS=
# Browser origins allowed by CORS (JSON list); default is the Streamlit dashboard.
# IQS_API__CORS_ORIGINS=["http://localhost:8501"]

IQS_TAXONOMY_PATH=configs/taxonomy/causes.yaml

# Vision service (step 1). Models are trained with scripts/train_detector.py into
# models/patchcore/<category>/<protocol>/; the API serves one protocol (deploy keeps the
# calibration images unseen). No VLM is configured: inspection responses have no
# "description" field (never faked).
IQS_VISION__MODELS_DIR=models/patchcore
IQS_VISION__PROTOCOL=deploy
IQS_VISION__MAX_UPLOAD_BYTES=10485760
IQS_VISION__MODEL_CACHE_SIZE=2
IQS_VISION__VLM_PROVIDER=none

# Dashboard (Streamlit, :8501). Base URL of the vision API as seen from the dashboard.
IQS_DASHBOARD__VISION_URL=http://localhost:8001

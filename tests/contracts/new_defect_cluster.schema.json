{
  "$defs": {
    "NewDefectClusterPayload": {
      "additionalProperties": false,
      "description": "A new cluster of unknown anomalies (vision discovery trigger, step 7).\n\nThe step-7 fields (``line_id`` ... ``score_median``) are optional additions to schema\nversion 1: no producer or consumer existed before step 7 (ADR-015). ``linkage`` says\nwhether ``part_ids`` / ``simulator_run_id`` come from the synthetic image-to-part\nlinker; real process linkage does not exist in this project.",
      "properties": {
        "category": {
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "cluster_id": {
          "format": "uuid",
          "title": "Cluster Id",
          "type": "string"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "inspection_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Inspection Ids",
          "type": "array"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "line_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Id"
        },
        "linkage": {
          "default": "none",
          "enum": [
            "synthetic_simulator",
            "none"
          ],
          "title": "Linkage",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "part_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Part Ids",
          "type": "array"
        },
        "representative_inspection_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Representative Inspection Id"
        },
        "score_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score Max"
        },
        "score_median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score Median"
        },
        "simulator_run_id": {
          "anyOf": [
            {
              "pattern": "^run-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Simulator Run Id"
        },
        "size": {
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "cluster_id",
        "category",
        "size",
        "first_seen",
        "last_seen",
        "inspection_ids",
        "model_version"
      ],
      "title": "NewDefectClusterPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/NewDefectClusterPayload"
    },
    "producer": {
      "const": "vision",
      "default": "vision",
      "title": "Producer",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "type": {
      "const": "new_defect_cluster",
      "default": "new_defect_cluster",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "payload"
  ],
  "title": "NewDefectClusterEvent",
  "type": "object"
}
